# Aegis — Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# LLM Provider API Keys
# ============================================================
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here
GOOGLE_API_KEY=your-google-ai-key-here

# ============================================================
# LangSmith Observability
# ============================================================
LANGSMITH_API_KEY=lsv2_your-langsmith-key
LANGSMITH_PROJECT=aegis-semantic-spend-orchestrator
LANGSMITH_TRACING=true

# ============================================================
# Neo4j Graph Database
# ============================================================
NEO4J_PASSWORD=aegis_graph

# ============================================================
# Slack Integration (Optional — Layer 4)
# ============================================================
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret

# ============================================================
# CRM Integration (Optional — Layer 4)
# ============================================================
CRM_API_URL=https://api.hubspot.com/crm/v3
CRM_API_KEY=your-crm-api-key

# ============================================================
# Application Settings
# ============================================================
LOG_LEVEL=INFO
MAX_NEGOTIATION_ROUNDS=3
REMEDIATION_TIMEOUT_HOURS=48
FRAUD_SCORE_THRESHOLD=0.6
LLM_COST_CEILING_DAILY=50.00
